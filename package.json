{
  "name": "elan1-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "elan1 \u2014 the agentic transformation company. Corporate marketing website.",
  "scripts": {
    "dev": "vite",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "prebuild": "node scripts/gen-sitemap.mjs && node scripts/gen-redirects.mjs",
    "build": "tsc -b && vite build && node scripts/prerender-meta.mjs",
    "preview": "vite preview",
    "check:seo": "node scripts/check-seo.mjs",
    "lhci": "lhci autorun",
    "gen:redirects": "node scripts/gen-redirects.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:nav": "node scripts/check-nav.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  }
}
